{
    "name": "ez-php/otel",
    "version": "2.5.2",
    "description": "OpenTelemetry-style spans and OTLP/HTTP JSON export for the ez-php framework, without a vendor SDK",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Uretschnig",
            "email": "andreas.uretschnig@gmail.com"
        }
    ],
    "keywords": [
        "otel",
        "opentelemetry",
        "tracing",
        "otlp",
        "observability",
        "php",
        "framework",
        "ez-php"
    ],
    "homepage": "https://github.com/ez-php/otel",
    "support": {
        "issues": "https://github.com/ez-php/otel/issues",
        "source": "https://github.com/ez-php/otel"
    },
    "require": {
        "php": "^8.5",
        "ez-php/contracts": "^2.0",
        "ez-php/http": "^2.0"
    },
    "suggest": {
        "ez-php/framework": "Needed to bind OtelServiceProvider and register OtelMiddleware in the request pipeline",
        "ez-php/logging": "Needed to correlate trace IDs with RequestContextMiddleware's request_id via TraceId::fromSeed()"
    },
    "require-dev": {
        "ez-php/docker": "^2.0",
        "ez-php/framework": "^2.0",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EzPhp\\Otel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "full": "composer analyse && composer cs && composer test"
    }
}
